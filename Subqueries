-- Correlated Subquery Questions 

-- 1.	Find employees whose salary is greater than the average salary of their department.
SELECT emp_id,
       emp_name,
       dept_id,
       salary
FROM Employees e
WHERE salary >
(
    SELECT AVG(salary)
    FROM Employees
    WHERE dept_id = e.dept_id
);

-- 2.	Find employees who earn the highest salary in their department.
select emp_id,
emp_name,
dept_id,
salary from 
employees e
where salary=
(
select max(salary) from employees where dept_id=e.dept_id 
);
select * from employees;

-- 3.	Find employees whose performance rating is higher than the average performance rating in their department.
SELECT emp_id,
       emp_name,
       dept_id,
       performance_rating
FROM Employees e
WHERE performance_rating >
(
    SELECT AVG(performance_rating)
    FROM Employees
    WHERE dept_id = e.dept_id
);


-- 4.	Find employees who joined after the average join date of their department.
SELECT emp_id,
       emp_name,
       dept_id,
       join_date
FROM Employees e
WHERE join_date >
(
    SELECT AVG(join_date)
    FROM Employees
    WHERE dept_id = e.dept_id
);

-- 5.	Find employees whose salary is less than the maximum salary in their department.

SELECT emp_id,
       emp_name,
       dept_id,
       salary
FROM Employees e
WHERE salary <
(
    SELECT MAX(salary)
    FROM Employees
    WHERE dept_id = e.dept_id
);


-- 6.	Find employees whose salary is equal to the minimum salary in their department.

SELECT emp_id,
       emp_name,
       dept_id,
       salary
FROM Employees e
WHERE salary =
(
    SELECT MIN(salary)
    FROM Employees
    WHERE dept_id = e.dept_id
);

-- 7.	Find departments that have employees earning more than 70000.
SELECT dept_id,
       dept_name
FROM Departments d
WHERE EXISTS
(
    SELECT 1                              
    FROM Employees e
    WHERE e.dept_id = d.dept_id
      AND e.salary > 70000
);



-- 8.	Find employees whose salary is greater than at least one employee in their department.
-- > ANY = greater than at least one value
-- > ALL = greater than every value

SELECT emp_id,
       emp_name,
       dept_id,
       salary
FROM Employees e
WHERE salary > ANY
(
    SELECT salary
    FROM Employees
    WHERE dept_id = e.dept_id
);

-- 9.	Find employees who are the only employee in their department
SELECT emp_id,
       emp_name,
       dept_id
FROM Employees e
WHERE 1 =
(
    SELECT COUNT(*)
    FROM Employees
    WHERE dept_id = e.dept_id
);


-- 10.	Find employees whose salary is greater than the average salary of employees who joined after them.

SELECT emp_id,
       emp_name,
       salary,
       join_date
FROM Employees e
WHERE salary >
(
    SELECT AVG(salary)
    FROM Employees
    WHERE join_date > e.join_date
);
select * from employees;
