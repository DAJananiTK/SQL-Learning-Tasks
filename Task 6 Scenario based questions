-- 11.	Calculate total sales month-wise from orders and products table

SELECT
    MONTH(o.order_date) AS Month,
    SUM(o.quantity * p.price) AS Total_Sales
FROM Orders o
JOIN Products p
ON o.product_id = p.product_id
GROUP BY MONTH(o.order_date)
ORDER BY Month;
output--
1	105000.00
2	14000.00


