--2.	Replace NULL salaries with 0 in the Employees table. 

SELECT emp_id, emp_name,             (Without changing data)
       IFNULL(salary, 0) AS salary
FROM Employees;        


UPDATE Employees                      (Permanenet update in database)
SET salary = 0
WHERE salary IS NULL;        
