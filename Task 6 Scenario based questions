-- 16.	Compare this month sales with last month sales. 

SELECT
    MONTH(o.order_date) AS month_no,
    SUM(o.quantity * p.price) AS total_sales,
    LAG(SUM(o.quantity * p.price))
        OVER (ORDER BY MONTH(o.order_date)) AS previous_month_sales
FROM Orders o
JOIN Products p
ON o.product_id = p.product_id
GROUP BY MONTH(o.order_date);

output--
1	105000.00	
2	14000.00	105000.00


-- 17.	Find top 3 products by revenue. 

SELECT
    p.product_name,
    SUM(o.quantity * p.price) AS revenue
FROM Orders o
JOIN Products p
ON o.product_id = p.product_id
GROUP BY  p.product_name
ORDER BY revenue DESC
LIMIT 3;

output--
Laptop	55000.00
Mobile	50000.00
Shoes	9000.00


